# Template for /etc/clusterbuck/worker.env — chmod 0600.
#
# A worker needs NO operator secret: it enrolls with a one-time join token and then
# authenticates with its own per-node key (ADR 26). Keep the real file out of the repo.

# --- required ---------------------------------------------------------------------
# Must match the coordinator's Redis, password included.
CBK_REDIS_URL=redis://:CHANGE_ME_redis_password@COORDINATOR_HOST:6379/0
# The coordinator, for enroll + heartbeat.
CBK_SERVER_URL=http://COORDINATOR_HOST:8018
# This node's local OpenAI-compatible model server.
CBK_MODEL_SERVER_URL=http://127.0.0.1:11434/v1
CBK_MODEL=CHANGE_ME_model_name

# --- node state -------------------------------------------------------------------
# Identity from enrollment, plus the presence mode `cbk pause`/`resume` writes.
CBK_NODE_STATE=/var/lib/clusterbuck/node.json

# --- self-update (ADR 13) ---------------------------------------------------------
# The PINNED public key. Without it the worker REFUSES to self-update — signed or
# nothing, no "trust once" path. Pair with `auto_update` on the node's policy.
# NOTE (Python worker): self-update also needs `cryptography` in the interpreter that
# runs the zipapp (pip install cryptography). Without it the worker runs normally and
# refuses updates — it will say so distinctly, not as a signature error.
#CBK_UPDATE_PUBKEY=/etc/clusterbuck/update-signing.pub.pem

# --- optional ---------------------------------------------------------------------
# How long the owner must be stably away before climbing to the big models (ADR 10).
# A dedicated box wants this near zero; a shared laptop wants minutes.
#CBK_LADDER_HYSTERESIS_S=120
# auto | ollama | lmstudio | none. `auto` probes for whichever native API answers;
# `none` = discovery over /v1/models only, no installs and no unloading.
#CBK_MODEL_MANAGER=auto
# At start-up, how long to hold off claiming while waiting for the coordinator to judge
# this build (ADR 27). After that the worker serves anyway, so a coordinator outage costs
# this much idle time and no more.
#CBK_VERDICT_WAIT_S=60
