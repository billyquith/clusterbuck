# Template for /etc/clusterbuck/server.env  — root-owned, chmod 0600.
#
# Copy, fill in, and keep the real file OUT of the repo: it holds secrets, and this project
# forbids committing hostnames or home-network specifics (see .claude/CLAUDE.md).
#   sudo install -m 0600 -o root -g root server.env.example /etc/clusterbuck/server.env

# --- required ---------------------------------------------------------------------
# Operator shared secret for the whole API. UNSET = UNAUTHENTICATED: any host that can
# reach the port could submit jobs, mint join tokens, and approve model installs (ADR 26).
CBK_API_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# Redis holds every prompt and completion in PLAINTEXT, so give it a password
# (`requirepass` in redis.conf) and put it here. Without one, any LAN host can read them.
CBK_REDIS_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6379/0

# --- paths ------------------------------------------------------------------------
CBK_DB_PATH=/var/lib/clusterbuck/cbk.db
CBK_FLEET_PATH=/etc/clusterbuck/fleet.yaml
CBK_HOST=0.0.0.0
CBK_PORT=8000

# --- worker version governance (ADR 27) -------------------------------------------
# What the fleet should be running. Behind this = `stale` (flagged, still serving).
CBK_WORKER_CURRENT_VERSION=0.7.0
# Below this = quarantined (stops claiming jobs). Leave unset until you have a reason.
#CBK_WORKER_MIN_VERSION=0.7.0
# Specific known-bad releases, comma-separated. Bugs are not monotonic, so this exists
# to block e.g. 1.4.2 while 1.4.1 and 1.4.3 stay fine.
#CBK_WORKER_BLOCKED_VERSIONS=

# --- self-update (ADR 13) — optional, off unless BOTH are set ----------------------
# The signing key is remote-code-execution if leaked. Root-owned, 0600, never in git.
#CBK_UPDATE_SIGNING_KEY=/etc/clusterbuck/update-signing.key.pem
#CBK_UPDATE_RELEASE=/etc/clusterbuck/release.json

# --- optional ---------------------------------------------------------------------
# Wake-on-LAN broadcast address for your subnet (default 255.255.255.255).
#CBK_WOL_BROADCAST=
# Cloud fallback for the SYNC plane only. Unset = local-only. Note sync-plane cloud
# control is coarse/config-level, not per-request (ADR 23).
#CBK_CLOUD_FALLBACK_MODEL=
#CBK_CLOUD_BUDGET_MONTHLY=
