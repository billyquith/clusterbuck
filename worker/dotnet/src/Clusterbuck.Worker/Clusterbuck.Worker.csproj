<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cbk</AssemblyName>

    <!-- The agent version the coordinator uses to judge whether this worker is fit to run
         jobs. Stamped at build time and read back at runtime, so it can never drift from the
         binary the way a hardcoded constant can. Bump on any release that changes worker
         behaviour the coordinator cares about. -->
    <Version>0.7.0</Version>
    <RootNamespace>Clusterbuck.Worker</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Native AOT is the shipping format (ADR 19). Spectre.Console.Cli was removed because
         its reflection-based command binding made the worker un-AOT-able; the CLI is now a
         hand-rolled dispatcher (Cli.cs). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

</Project>
